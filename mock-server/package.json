{
  "name": "mecenate-mock-server",
  "version": "1.0.0",
  "private": true,
  "description": "Mock server for Mecenate Test API with REST and WebSocket support",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "generate-api": "orval --config orval.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "orval": "^8.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.9.2"
  }
}
